{
  "source": "work/recovered/h5_snapshot.py downloaded H5 code.js and zip.txt from taptapReleaseRes; verified statically in Laya client",
  "channel": {
    "name": "TapTap",
    "class": "Channel_NewWX",
    "environment": "rpenv=wx selects release",
    "version": "1.0.1",
    "login_way": 102,
    "mix_way": 4,
    "platform": "unknow",
    "cgi_domain": "cjjlqwxweb.ruiruiyouxi.com",
    "resource_base": "https://cjjlqres.ruiruiyouxi.com/taptapReleaseRes/"
  },
  "http": {
    "base": "https://cjjlqwxweb.ruiruiyouxi.com/rp_web/",
    "common_query": {
      "login_way": 102,
      "envi": 2,
      "version": "1.0.1",
      "platform": "unknow",
      "mix_way": 4
    },
    "svr_list": {
      "method": "GET",
      "path": "svr_list",
      "request_extra": {
        "showOne": 1
      },
      "response_fields": [
        "ret",
        "svr_list",
        "in_white_list",
        "login_svr_id_list",
        "sid",
        "token",
        "submit_flag",
        "cvv",
        "msg"
      ],
      "live_probe": {
        "http_status": 200,
        "body": {
          "msg": "system error",
          "ret": -1
        }
      }
    },
    "regist": {
      "method": "GET",
      "path": "regist",
      "side_effect": "May create a player account; not called during this task",
      "request_fields": [
        "choicePetId",
        "zone_id",
        "oaid",
        "name",
        "sex",
        "inviter_user_id",
        "inviter_zone_id",
        "invite_type",
        "share_id",
        "share_img_id"
      ],
      "success_fields": [
        "ret",
        "sid",
        "token",
        "user_id"
      ]
    },
    "dir": {
      "method": "GET",
      "path": "dir",
      "request_fields": [
        "zone_id",
        "user_id",
        "showData"
      ],
      "success_fields": [
        "ret",
        "ip",
        "port",
        "city",
        "share_flag"
      ]
    },
    "ip_level": {
      "method": "GET",
      "path": "ip_level",
      "success_fields": [
        "ret",
        "level"
      ]
    }
  },
  "transport": {
    "websocket_header_bytes": 32,
    "byte_order": "big-endian",
    "fields": [
      {
        "offset": 0,
        "bytes": 8,
        "name": "user_id",
        "type": "uint64"
      },
